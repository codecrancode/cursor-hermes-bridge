# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_CHAT_IDS=[123456789,987654321]

# API Configuration
API_HOST=127.0.0.1
API_PORT=8920
API_SECRET_TOKEN=

# Storage Configuration
DATABASE_PATH=data/cursor-bridge.db
JSONL_EXPORT_PATH=

# Watcher Configuration
WATCHER_LOG_PATHS=[]

# Adapter Configuration
ADAPTER_PRIMARY=cursor_logs
ENABLE_CDP_ADAPTER=false

# Summarizer Configuration
SUMMARIZER_TYPE=local

# Logging Configuration
LOG_LEVEL=INFO

# Platform-specific Cursor paths (macOS default)
CURSOR_LOG_DIR=~/Library/Application Support/Cursor/logs/
CURSOR_SESSION_DIR=~/Library/Application Support/Cursor/sessions/